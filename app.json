{
  "expo": {
    "name": "Ratio",
    "slug": "ratio",
    "version": "1.0.0",
    "orientation": "default",
    "userInterfaceStyle": "dark",
    "newArchEnabled": false,
    "android": {
      "package": "app.ratio.camera",
      "versionCode": 1,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "ios": {
      "bundleIdentifier": "app.ratio.camera",
      "supportsTablet": false,
      "infoPlist": {
        "NSCameraUsageDescription": "Ratio takes photos at your screen's ratio."
      }
    },
    "plugins": [
      [
        "react-native-vision-camera",
        {
          "cameraPermissionText": "Ratio takes photos at your screen's ratio.",
          "enableMicrophonePermission": false,
          "enableFrameProcessors": false
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Ratio saves photos to your gallery.",
          "savePhotosPermission": "Ratio saves photos to your gallery.",
          "isAccessMediaLocationEnabled": false
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "20585ef8-5449-4f74-9ef4-91dbc954788b"
      }
    }
  }
}
